{
	"extends": "./tsconfig.node.json",
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
		// React 側が AppType を型として読むため、宣言ファイルだけを出力する（tsconfig.app.json の references）
		"composite": true,
		"noEmit": false,
		"emitDeclarationOnly": true,
		"outDir": "./node_modules/.tmp/worker-types",
		"types": ["vite/client", "./worker-configuration.d.ts"]
	},
	"include": ["src/worker", "src/lib", "src/shared"]
}
